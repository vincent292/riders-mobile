# Riders Mobile - Expo
# Copia este archivo como .env.local o .env antes de correr Expo.

# URL publica del SaaS que expone /api/mobile/riders/*
# En celular no uses localhost. Usa dominio, tunnel HTTPS o IP LAN accesible.
EXPO_PUBLIC_API_BASE_URL=https://yopido.shop

# Supabase public config. Debe ser el mismo proyecto que usa el SaaS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Si tu proyecto todavia usa anon key, tambien sirve:
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Auth se configura en Supabase Dashboard > Authentication > Providers > Google.
# Redirect URLs:
# - Development/standalone build: ridersmobile://auth/callback
# - Expo Go: exp://<ip-o-tunnel>:8081/--/auth/callback
# Si quieres forzar una URL concreta, ponla aqui y agregala tambien en Supabase.
EXPO_PUBLIC_AUTH_REDIRECT_URI=

# Google Maps / Google Cloud
# Habilita Maps SDK for Android y, si vas a abrir rutas, Maps URLs no requiere secreto.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Para builds Android nativos/development build. Si se omite, usa EXPO_PUBLIC_GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_ANDROID_API_KEY=

# Firebase Android / FCM. Debe ser el google-services.json de la app
# con package name shop.yopido.riders. En EAS se recomienda variable tipo file.
GOOGLE_SERVICES_JSON=./google-services.json
