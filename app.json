{
  "expo": {
    "name": "riders-mobile",
    "slug": "riders-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expo.icon/Generated/app-icon-dark-square.png",
    "scheme": "ridersmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon/Generated/app-icon-dark-square.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1626",
        "foregroundImage": "./assets/expo.icon/Generated/adaptive-foreground.png",
        "monochromeImage": "./assets/expo.icon/Generated/monochrome-symbol.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/expo.icon/Generated/favicon-square.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1626",
          "image": "./assets/expo.icon/Assets/splash/splash-dark.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#0B1626",
            "image": "./assets/expo.icon/Assets/splash/splash-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c53159d-980c-4c1d-b408-a32a94c01699"
      }
    }
  }
}
